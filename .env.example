# Copy to .env for local dev. All settings are prefixed MINUTES_.
MINUTES_APP_ENV=local
MINUTES_DATABASE_URL=postgresql+asyncpg://minutes:minutes@localhost:5432/minutes
MINUTES_REDIS_URL=redis://localhost:6379/0

# Object storage (S3 protocol). Local: MinIO. Prod: S3-compatible object storage (EU region).
# Leave false to use in-memory FakeStorage (no archival); set true for real S3/Spaces uploads.
MINUTES_S3_ENABLED=false
MINUTES_S3_ENDPOINT_URL=http://localhost:9000
MINUTES_S3_REGION=eu-central-1
MINUTES_S3_BUCKET=minutes-audio
MINUTES_S3_ACCESS_KEY=minutes
MINUTES_S3_SECRET_KEY=minutes-secret

# External sub-processors (set when their build-order steps land)
MINUTES_SONIOX_API_KEY=
MINUTES_ANTHROPIC_API_KEY=

# Auth edge — capability tokens.
#   local/dev/test: leave unset to use the built-in dev default.
#   staging/prod:   REQUIRED, >=32 bytes, non-default — the app refuses to boot otherwise.
#                   generate with: openssl rand -hex 32
# MINUTES_AUTH_SECRET=
MINUTES_AUTH_TOKEN_TTL_S=3600

# Admission + timing budget (seconds unless noted)
MINUTES_MAX_CONCURRENT_CALLS=5
MINUTES_CHUNK_INTERVAL_MINUTES=15
MINUTES_LEASE_TTL_S=60
MINUTES_HEARTBEAT_S=20
MINUTES_JOIN_TIMEOUT_S=45
MINUTES_IDLE_TIMEOUT_S=120
MINUTES_MEDIA_INACTIVITY_S=30
MINUTES_DRAIN_DEADLINE_S=25
MINUTES_RETENTION_DAYS=90
