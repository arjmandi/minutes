# Single-box deployment env. Copy to `.env` and fill in. NEVER commit `.env`.
#
#   cp .env.example .env

# ---------- required ----------
MINUTES_AUTH_SECRET=          # `openssl rand -hex 32` — >=32 bytes; prod refuses a weak/default secret
MINUTES_SECRET_KEY=           # `openssl rand -hex 32` — encrypts per-user API keys; prod-required
MINUTES_SONIOX_API_KEY=       # Soniox real-time STT key
POSTGRES_PASSWORD=            # any strong value
DOMAIN=                       # e.g. meet.example.com — DNS A record must point at this VPS (for wss:// TLS)

# MinIO admin (used ONLY by the minio-init bootstrap, never by the app)
MINIO_ROOT_USER=minutes-admin
MINIO_ROOT_PASSWORD=          # >=8 chars

# App-scoped MinIO service account (least privilege: Get/Put/Delete on minutes-audio/* only).
# minio-init mints this at boot; the backend uses it instead of the root credential.
MINUTES_S3_ACCESS_KEY=minutes-app   # >=3 chars
MINUTES_S3_SECRET_KEY=              # >=8 chars

# ---------- optional ----------
MINUTES_ANTHROPIC_API_KEY=    # Claude translation key; empty -> translation disabled (STT still works)
# JSON array of target languages. A target equal to the detected source language is SKIPPED, so
# ["en"] yields no output for English speech — pick targets that differ from the spoken language.
MINUTES_TRANSLATION_TARGETS=["de"]
MINUTES_MAX_CONCURRENT_CALLS=5       # lower (e.g. 2-3) if the KVM2 box struggles under load
# Recording people in the EU needs a lawful basis. true -> ingest refuses meetings without recorded
# consent. Set false ONLY if you have an alternative lawful basis (and understand the obligation).
MINUTES_REQUIRE_CONSENT=true
MINUTES_RETENTION_DAYS=90            # purge meetings + their audio older than this (run daily)
