# TLS-terminating, WebSocket-aware edge for the single-box deployment.
#
# Path-split on one domain:
#   /            -> marketing landing (static, mounted at /srv/landing; kept out of this repo)
#   /docs        -> documentation site (static, mounted at /srv/docs; kept out of this repo)
#   /app, /api, /assets, /shared, /ingest, /healthz, /readyz -> the product backend
# A stock open-source self-host with no landing mounted falls back to serving the app at / too.
#
# Caddy auto-provisions a Let's Encrypt cert for $DOMAIN and transparently proxies the long-lived
# wss:// ingest + live-view WebSockets (forwards Sec-WebSocket-Protocol unmodified, no idle timeout).
# $DOMAIN must resolve (DNS A record) to this VPS.
#
# For Let's Encrypt expiry notifications, add a global options block at the top:
#   { email you@example.com }

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	# Product app + API + capture/live WebSockets + SPA assets + public share viewer -> backend.
	# (/docs is the documentation site below, not FastAPI's Swagger.)
	@app path /app /app/* /api/* /assets/* /shared /shared/* /ingest /healthz /readyz
	handle @app {
		reverse_proxy backend:8000
	}

	# Documentation site (Docusaurus static build, baseUrl /docs/, mounted at /srv/docs).
	handle /docs {
		redir /docs/ 308
	}
	handle /docs/* {
		root * /srv
		file_server
	}

	# Everything else is the marketing landing. If none is mounted, fall back to the app so /
	# still serves the product (stock open-source self-host).
	handle {
		root * /srv/landing
		@nolanding {
			not file /index.html
		}
		handle @nolanding {
			reverse_proxy backend:8000
		}
		try_files {path} /index.html
		file_server
	}
}
