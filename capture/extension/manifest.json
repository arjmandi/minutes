{
  "manifest_version": 3,
  "name": "minutes capture",
  "version": "0.4.4",
  "description": "Sign in to minutes and stream the active Google Meet / Teams tab audio (plus your mic, or mic-only on any tab) for live transcription + translation.",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://*/*",
    "http://localhost/*"
  ],
  "icons": {
    "16": "icons/idle-16.png",
    "32": "icons/idle-32.png",
    "48": "icons/idle-48.png",
    "128": "icons/idle-128.png"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*", "https://teams.microsoft.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "minutes",
    "default_icon": {
      "16": "icons/idle-16.png",
      "32": "icons/idle-32.png",
      "48": "icons/idle-48.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
